  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCInteraction
  dialoguePanel: {fileID: 1630294209}
  npcName: {fileID: 1516719494}
  dialogueText: {fileID: 937987194}
  characterName: Maya
  dialogueLines:
  - 'Maya: "Stay back! I swear I''ll use this!"'
  - 'Player: "Relax. I''m not here to hurt you."'
  - 'Maya: "That''s what they all say before they take everything."'
  - 'Player: "I''m offering you shelter. There''s a van nearby."'
  - 'Maya: "And what do you want in return?"'
  - 'Player: "Nothing. Just get inside and stay alive."'
  - 'Maya: "Nothing? Nobody does anything for nothing anymore."'
  - 'Player: "You can trust me, or you can stay here. Your choice."'
  - 'Maya: "I don''t know how to trust anyone. But I''m tired... I''m so tired."'
  choicePrompt: 'Will you let her stay? (Y: Accept / N: Reject)'
  onAccept:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 1041129133}
        m_TargetAssemblyTypeName: NPC, Assembly-CSharp
        m_MethodName: GivePermission
        m_Mode: 1
        m_Arguments:
