--- !u!114 &6071389450259783349
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 576601912747233121}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ff85a21e1dde85349b516fc245dd6fcb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCInteraction
  dialoguePanel: {fileID: 1630294209}
  npcName: {fileID: 1516719494}
  dialogueText: {fileID: 937987194}
  characterName: Alcoholic Brother
  dialogueLines:
  - 'Julian: "Hey... hey, you! Don''t walk away. I need a minute."'
  - 'Player: "You look like you haven''t slept in days."'
  - 'Player: "What do you want?"'
  - 'Julian: "I''ve got a bottle of alcohol and a spare gear. Found them while scavenging.
    You help me get somewhere safe, they''re yours."'
  - 'Player: "Why would you give away something useful?"'
  - 'Julian: "Because the bottle isn''t helping me anymore. And that gear? It''s
    just dead weight if I don''t survive."'
  - 'Player: "Fine. You can come with me."'
  - 'Julian: "Thank you... Seriously. Maybe my brother''s still alive out there.
    If you find him, tell him I''m sorry."'
  choicePrompt: 'Will you let him stay? (Y: Accept / N: Reject)'
  onAccept:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 6071389450259783346}
        m_TargetAssemblyTypeName: NPC, Assembly-CSharp
        m_MethodName: GivePermission
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
  onReject:
    m_PersistentCalls:
      m_Calls: []
