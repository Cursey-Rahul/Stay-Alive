  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InventoryData
  characterName: Leo
  characterPhoto: {fileID: -7230391701638731982, guid: 72ce0611bfcfcd949b2fa49af2eae9b8, type: 3}
  designation: Desperate Scavenger
  backstory: Stranded and running on fumes after an bitter falling out with his older
    brother right before the outbreak, Leo navigates the decaying streets. Plagued
    by guilt over their final argument, he trades critical vehicle parts for a chance
    at safety and reunion.
