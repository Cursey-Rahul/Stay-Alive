  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ff85a21e1dde85349b516fc245dd6fcb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCInteraction
  dialoguePanel: {fileID: 1630294209}
  npcName: {fileID: 1516719494}
  dialogueText: {fileID: 937987194}
  characterName: leo
  dialogueLines:
  - 'Leo: "You''re looking for supplies, aren''t you? I can tell by the way you''re
    checking everything."'
  - 'Player: "I''m fixing a van. We need parts if we''re going to get out of here."'
  - 'Leo: "A van? Then you might be in luck. I''ve got a battery and a spare gear."'
  - 'Player: "What''s the catch?"'
  - 'Leo: "You let me stay with your group. I''m not going to last much longer alone."'
  - 'Player: "Do you know anything about the area?"'
  - 'Leo: "Enough to know it''s getting worse. Have you seen a man carrying a bottle?
    He''s my brother."'
  - 'Player: "I might have. What''s his name?"'
  - 'Leo: "Does it matter? He''s my brother. We had a fight before all this started.
    I need to know he''s alive."'
  choicePrompt: 'Will you let him stay? (Y: Accept / N: Reject)'
  onAccept:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 2129042636}
        m_TargetAssemblyTypeName: NPC, Assembly-CSharp
        m_MethodName: GivePermission
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
  onReject:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 2129042636}
        m_TargetAssemblyTypeName: NPC, Assembly-CSharp
        m_MethodName: RevokePermission
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
