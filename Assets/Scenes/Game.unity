  m_Script: {fileID: 11500000, guid: ff85a21e1dde85349b516fc245dd6fcb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCInteraction
  dialoguePanel: {fileID: 1630294209}
  npcName: {fileID: 1516719494}
  dialogueText: {fileID: 937987194}
  characterName: Arthur
  dialogueLines:
  - 'Arthur: "Careful! Careful! You nearly stepped on a perfectly preserved relic."'
  - 'Player: "That''s a broken watch."'
  - 'Arthur: "A pocket watch! A beautiful piece of craftsmanship from a world that
    no longer exists."'
  - 'Player: "You collect junk?"'
  - 'Arthur: "I collect history. Every object has a story, even when the people who
    made it are gone."'
  - 'Player: "I''m looking for mechanical parts. Gears, specifically."'
  - 'Arthur: "Gears? Well, now you''ve caught my attention. I have two spares in
    my collection."'
  - 'Player: "Will you trade them?"'
  - 'Arthur: "Trade? Such an ugly word. Let us say I''ll entrust them to someone
    who can put them to good use."'
  - 'Player: "And what do you want?"'
  - 'Arthur: "A place in your van. I''d rather see another sunrise than spend my
    final days cataloguing relics alone."'
  choicePrompt: 'Will you let him stay? (Y: Accept / N: Reject)'
  onAccept:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 2020718380}
        m_TargetAssemblyTypeName: NPC, Assembly-CSharp
        m_MethodName: GivePermission
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
  onReject:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 2020718380}
        m_TargetAssemblyTypeName: NPC, Assembly-CSharp
        m_MethodName: RevokePermission
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
