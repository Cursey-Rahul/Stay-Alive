  m_Script: {fileID: 11500000, guid: ff85a21e1dde85349b516fc245dd6fcb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCInteraction
  dialoguePanel: {fileID: 1630294209}
  npcName: {fileID: 1516719494}
  dialogueText: {fileID: 937987194}
  characterName: Vance
  dialogueLines:
  - 'Vance: "Finally! Someone who looks like they know what they''re doing."'
  - 'Player: "You don''t look like the survivalist type."'
  - 'Vance: "And you don''t look like someone who can afford to waste time judging
    people."'
  - 'Player: "What do you have?"'
  - 'Vance: "Two full fuel cans. Before the world ended, I ran an oil business. Turns
    out, that experience is suddenly worth a fortune."'
  - 'Player: "And you want shelter?"'
  - 'Vance: "Correct. You give me a seat in that van, and the fuel is yours. A simple
    business arrangement."'
  - 'Player: "You expect me to trust a businessman during the apocalypse?"'
  - 'Vance: "Trust? No, no. Trust is a luxury. Let''s call it a mutually beneficial
    investment."'
  choicePrompt: 'Will you let him stay? (Y: Accept / N: Reject)'
  onAccept:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 1566535660}
        m_TargetAssemblyTypeName: NPC, Assembly-CSharp
        m_MethodName: GivePermission
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
  onReject:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 1566535660}
        m_TargetAssemblyTypeName: NPC, Assembly-CSharp
        m_MethodName: RevokePermission
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
